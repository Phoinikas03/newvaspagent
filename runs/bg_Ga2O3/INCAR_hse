SYSTEM = HSE06 Band Gap Calculation for Ga2O3 (restart from PBE)
# --- 电子结构 ---
ISTART  = 1          # 从 PBE 的 WAVECAR 读取初始波函数
ICHARG  = 2          # 从 CHGCAR 读取电荷密度
PREC    = Accurate
ENCUT   = 520        # 与 PBE SCF 阶段完全一致
EDIFF   = 1E-5       # HSE 收敛标准
NELM    = 100

# --- 杂化泛函 HSE06 ---
LHFCALC = .TRUE.
HFSCREEN = 0.2       # HSE06 标准屏蔽参数
AEXX     = 0.25      # HSE06 标准精确交换混合比例

# --- 算法（氧化物推荐 All） ---
ALGO    = All

# --- 加速选项 ---
PRECFOCK = Fast

# --- 展宽 ---
ISMEAR  = 0
SIGMA   = 0.05

# --- 输出 ---
LWAVE   = .FALSE.
LCHARG  = .FALSE.

# --- K 点（必须与 PBE SCF 完全一致）---
KSPACING = 0.15
KGAMMA   = .TRUE.

# --- 并行参数（8 GPU）---
KPAR    = 8
