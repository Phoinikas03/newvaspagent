# 静态单点能模板 — 用于 ENCUT / KSPACING 收敛测试（NSW=0）
# GaN 六方晶系

SYSTEM = GaN static single-point convergence test
PREC   = Accurate

# --- 收敛测试参数 (按步替换) ---
ENCUT    = 520          # <-- ENCUT 扫描时逐步替换
KSPACING = 0.20         # <-- ENCUT 阶段可固定较密值；KSPACING 阶段逐步替换
KGAMMA   = .TRUE.

# --- 电子步参数 ---
ISMEAR = 0
SIGMA  = 0.05
EDIFF  = 1E-6
NELM   = 100

# --- 离子步：必须静态 ---
NSW    = 0
ISIF   = 2
IBRION = -1

# --- 输出控制 ---
LWAVE  = .FALSE.
LCHARG = .FALSE.
