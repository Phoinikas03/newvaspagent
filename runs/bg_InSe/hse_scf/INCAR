SYSTEM = HSE06 Band Gap Calculation for InSe (restart from PBE)
# --- 电子结构 ---
ISTART  = 1          # 必须！从 PBE 的 WAVECAR 读取初始波函数
ICHARG  = 2          # 从 CHGCAR 读取电荷密度
PREC    = Accurate
ENCUT   = 400        # 必须与 PBE SCF 阶段完全一致
EDIFF   = 1E-5       # HSE 收敛标准
NELM    = 100

# --- 杂化泛函 HSE06 ---
LHFCALC = .TRUE.
HFSCREEN = 0.2       # HSE06 标准屏蔽参数
AEXX     = 0.25      # HSE06 标准精确交换混合比例

# --- 算法 ---
ALGO    = Damped
TIME    = 0.4        # 与 ALGO=Damped 配合

# --- 加速选项 ---
PRECFOCK = Fast      # 加速 HF 积分

# --- 展宽 ---
ISMEAR  = 0
SIGMA   = 0.05

# --- 输出 ---
LWAVE   = .FALSE.    # HSE WAVECAR 体积极大，不保留
LCHARG  = .FALSE.

# --- K 点（必须与 PBE SCF 完全一致）---
KSPACING = 0.15      # 必须与 PBE 一致
KGAMMA   = .TRUE.

# --- 并行（7 GPU: 0,1,2,4,5,6,7，避开GPU 3）---
KPAR    = 7
