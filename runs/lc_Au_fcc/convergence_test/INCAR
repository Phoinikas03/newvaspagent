# 静态单点能模板 — FCC Au 收敛测试（NSW=0）
# 使用说明：复制到工作目录后改名为 INCAR，按 convergence_rules.md 修改 ENCUT、KSPACING

SYSTEM = FCC Au static single-point convergence test
PREC   = Accurate

# --- 收敛测试参数 (按步替换) ---
ENCUT    = 450          # <-- ENCUT 扫描时逐步替换
KSPACING = 0.15         # <-- ENCUT 阶段可固定较密值；KSPACING 阶段逐步替换
KGAMMA   = .TRUE.

# --- 电子步参数 ---
ISMEAR = 1              # 金属：Methfessel-Paxton 1阶
SIGMA  = 0.1
EDIFF  = 1E-6
NELM   = 100

# --- 离子步：必须静态 ---
NSW    = 0
ISIF   = 2
IBRION = -1

# --- 输出控制 ---
LWAVE  = .FALSE.
LCHARG = .FALSE.
