SYSTEM = Sb2Te3 Structural Relaxation (39 atoms, layered semiconductor)
# --- 电子结构 ---
ISTART  = 0          # 从头开始
ICHARG  = 2          # 从叠加原子电荷密度初始化
PREC    = Accurate
ENCUT   = 520        # ENMAX * 1.3 for relaxation
EDIFF   = 1E-6       # 电子步收敛标准
NELM    = 100        # 最大电子步数

# --- 交换关联 ---
GGA     = PE         # PBE 泛函

# --- vdW 修正 (层状材料) ---
IVDW    = 12         # DFT-D3(BJ) 阻尼校正，适用于层状材料

# --- 展宽 (半导体) ---
ISMEAR  = 0          # Gaussian 展宽
SIGMA   = 0.05       # 小展宽避免污染价带/导带

# --- 离子弛豫 ---
IBRION  = 2          # 共轭梯度法 CG
ISIF    = 3          # 全优化：原子+晶胞形状+体积
NSW     = 200        # 最大离子步数
EDIFFG  = -0.02      # 力收敛标准 (eV/Å)
POTIM   = 0.5        # CG步长

# --- 算法 ---
ALGO    = Normal

# --- 输出 ---
LWAVE   = .FALSE.
LCHARG  = .FALSE.

# --- K点 (INCAR定义，不生成KPOINTS) ---
KSPACING = 0.20
KGAMMA   = .TRUE.

# --- GPU并行参数 (8 GPU, KPAR对齐GPU数) ---
KPAR    = 8