# Machine-specific locations for the rev_* launch wrappers (bash syntax).
# Copy to <repo>/site.env (untracked). Unset variables fall back to the d01
# defaults that produced the manuscript / rep1 numbers.
#
# d01 (defaults):
#   VASPAGENT_CONDA_PREFIX=/data/xiazeyu/conda/envs/claude
#   ATOMATE2_CONDA_PREFIX=/mnt/data_x3/xiazeyu/conda-envs/atomate2
#   VASP_ENV_SCRIPT=$HOME/env_vasp
#
# d03 (rep2/rep3):
#   VASPAGENT_CONDA_PREFIX=/home/xiazeyu/conda-envs/vaspagent
#   VASP_ENV_SCRIPT=$HOME/env_vasp
